rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Structure data per-user: /users/{userId}/datasets/{datasetId}
    match /users/{userId}/{document=**} {
      // Users can only read and write data nested under their own User ID
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Deny access to any collection not nested under a user path
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
