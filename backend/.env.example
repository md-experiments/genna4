OPENAI_API_KEY=your_openai_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key
OPENROUTER_API_KEY=your_openrouter_api_key

# Setting GOOGLE_APPLICATION_CREDENTIALS is fundamentally required by Firebase Admin SDK
# If deploying to Railway, you can Base64 encode your serviceAccountKey.json and decode it during build,
# or inject it directly if using specific variables.
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json
